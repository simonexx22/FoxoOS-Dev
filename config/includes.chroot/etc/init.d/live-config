#!/bin/sh

### BEGIN INIT INFO
# Provides:          live-config
# Required-Start:    mountkernfs.sh mountdevsubfs.sh
# Required-Stop:
# Should-Start:      udev
# Default-Start:     S
# Default-Stop:
# Short-Description: live-config - System Configuration Components
# Description:       live-config contains the components that configure a live system.
### END INIT INFO

case "${1}" in
	start)
		if [ -e /usr/bin/live-config ]
		then
			/usr/bin/live-config ${@}
		fi
		;;

	force-reload|restart|stop)

		;;
esac

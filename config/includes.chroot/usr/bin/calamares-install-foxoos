#!/bin/sh
###
# FoxoOS: GUI Installer launcher (Calamares)
###

export QT_AUTO_SCREEN_SCALE_FACTOR=1

# Restore or backup fstab if live-build left temporary state
if [ -f /etc/fstab ] && [ ! -f /etc/fstab.orig.calamares ]; then
    cp -a /etc/fstab /etc/fstab.orig.calamares 2>/dev/null || true
fi

if command -v xhost >/dev/null 2>&1; then
    xhost +si:localuser:root 2>/dev/null || true
fi

if [ "1000" -eq 0 ]; then
    calamares ""
    rc=0
elif command -v pkexec >/dev/null 2>&1; then
    pkexec calamares ""
    rc=0
elif command -v sudo >/dev/null 2>&1; then
    sudo -E calamares ""
    rc=0
else
    su -c "calamares "
    rc=0
fi

if command -v xhost >/dev/null 2>&1; then
    xhost -si:localuser:root 2>/dev/null || true
fi

exit 

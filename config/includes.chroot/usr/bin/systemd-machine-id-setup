#!/bin/sh
# FoxoOS: SysVinit / OpenRC / D-Bus compatible machine-id generator
# Replaces systemd-machine-id-setup for Calamares and system initialization.
set -eu

ROOT=""
PRINT=0

for arg in "$@"; do
    case "$arg" in
        --root=*)
            ROOT="${arg#--root=}"
            ;;
        --print)
            PRINT=1
            ;;
        --help|-h)
            echo "Usage: systemd-machine-id-setup [--root=PATH] [--print]"
            exit 0
            ;;
        --version)
            echo "systemd-machine-id-setup (FoxoOS sysvinit/openrc compatibility 1.0)"
            exit 0
            ;;
    esac
done

TARGET_ETC="${ROOT}/etc"
TARGET_MID="${TARGET_ETC}/machine-id"
TARGET_DBUS_DIR="${ROOT}/var/lib/dbus"
TARGET_DBUS_MID="${TARGET_DBUS_DIR}/machine-id"

# Generate fresh 32-character hex ID (no hyphens) using dbus-uuidgen
if command -v dbus-uuidgen >/dev/null 2>&1; then
    NEW_ID="$(dbus-uuidgen)"
else
    NEW_ID="$(tr -dc '0-9a-f' < /dev/urandom | head -c 32)"
fi

if [ -z "${NEW_ID}" ] || [ "${#NEW_ID}" -ne 32 ]; then
    echo "ERROR: failed to generate valid 32-character hex machine-id" >&2
    exit 1
fi

mkdir -p "${TARGET_ETC}" "${TARGET_DBUS_DIR}"

# Write to target /etc/machine-id with trailing newline
printf '%s\n' "${NEW_ID}" > "${TARGET_MID}"
chmod 0444 "${TARGET_MID}" 2>/dev/null || chmod 0644 "${TARGET_MID}"

# Ensure target /var/lib/dbus/machine-id is a consistent symlink to /etc/machine-id
rm -f "${TARGET_DBUS_MID}"
ln -sf /etc/machine-id "${TARGET_DBUS_MID}"

if [ "${PRINT}" -eq 1 ]; then
    printf '%s\n' "${NEW_ID}"
fi

exit 0

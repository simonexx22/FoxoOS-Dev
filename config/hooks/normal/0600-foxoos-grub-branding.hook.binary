#!/bin/sh
# FoxoOS: brand the GRUB menu entries generated by live-build.
# This runs in the binary stage (cwd = binary/), after binary_grub_cfg has
# written boot/grub/*.cfg and before the ISO is assembled.
set -eu

# Ensure fonts directory exists and fonts are available
mkdir -p boot/grub/fonts
for f in dejavu.pf2 unicode.pf2; do
	if [ -e "boot/grub/${f}" ]; then
		cp -f "boot/grub/${f}" "boot/grub/fonts/${f}"
	fi
done

for _cfg in boot/grub/grub.cfg boot/grub/loopback.cfg; do
	[ -e "${_cfg}" ] || continue
	sed -i \
		-e "s|^menuentry \"Live system (amd64)\"|menuentry \"Uruchom FoxoOS Live\" --hotkey=u|" \
		-e "s|^menuentry \"Live system (amd64 fail-safe mode)\"|menuentry \"Tryb awaryjny\" --hotkey=t|" \
		-e "s|^menuentry \"Live system (autodetect)\"|menuentry \"Uruchom FoxoOS Live\" --hotkey=u|" \
		-e "s|^menuentry \"Live system (autodetect) (fail-safe mode)\"|menuentry \"Tryb awaryjny\" --hotkey=t|" \
		-e "s|^menuentry \"Live system, kernel |menuentry \"Uruchom FoxoOS Live, kernel |" \
		"${_cfg}"
done

# The theme title and fonts must support full UTF-8 (Polish characters)
if [ -e boot/grub/live-theme/theme.txt ]; then
	sed -i \
		-e "s|^title-text:.*|title-text: \"Wybór systemu\"|" \
		-e "s|\"Unifont Regular 16\"|\"DejaVu Sans Regular 16\"|g" \
		-e "s|Wiersz polecen GRUB|Wiersz poleceń GRUB|g" \
		boot/grub/live-theme/theme.txt
fi

echo "FoxoOS: GRUB menu branded and Polish fonts configured"
grep -h "^menuentry" boot/grub/*.cfg 2>/dev/null || true

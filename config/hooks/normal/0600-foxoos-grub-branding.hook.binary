#!/bin/sh
# FoxoOS: brand the GRUB menu entries generated by live-build.
# This runs in the binary stage (cwd = binary/), after binary_grub_cfg has
# written boot/grub/*.cfg and before the ISO is assembled.
set -eu

for _cfg in boot/grub/grub.cfg boot/grub/loopback.cfg; do
	[ -e "${_cfg}" ] || continue
	sed -i \
		-e 's|^menuentry "Live system (amd64)"|menuentry "FoxoOS 1.0 Live (amd64)"|' \
		-e 's|^menuentry "Live system (amd64 fail-safe mode)"|menuentry "FoxoOS 1.0 Live (amd64, fail-safe)"|' \
		-e 's|^menuentry "Live system (autodetect)"|menuentry "FoxoOS 1.0 Live (autodetect)"|' \
		-e 's|^menuentry "Live system (autodetect) (fail-safe mode)"|menuentry "FoxoOS 1.0 Live (autodetect, fail-safe)"|' \
		-e 's|^menuentry "Live system, kernel |menuentry "FoxoOS 1.0 Live, kernel |' \
		"${_cfg}"
done

# The theme title is the most visible label; keep it in sync if a future
# live-build version overwrites the file.
if [ -e boot/grub/live-theme/theme.txt ]; then
	sed -i 's|^title-text:.*|title-text: "FoxoOS 1.0 Live"|' boot/grub/live-theme/theme.txt
fi

# Ensure automatic boot timeout (live-build defaults to indefinite wait)
# and mirror GRUB to serial port ttyS0 for headless/QEMU testing.
if [ -e boot/grub/config.cfg ]; then
	cat >> boot/grub/config.cfg <<'EOF'

# FoxoOS: automatic boot timeout and serial console support
set timeout=5
set timeout_style=menu
if serial --unit=0 --speed=115200 2>/dev/null; then
	terminal_input --append serial
	terminal_output --append serial
fi
EOF
fi

echo "FoxoOS: GRUB menu branded"
grep -h '^menuentry' boot/grub/*.cfg 2>/dev/null || true

#!/usr/bin/expect -f
set timeout 900
set iso "/home/foxos/foxoos/foxoos-1.0-amd64.iso"
set disk "/tmp/test_sata.raw"

log_user 1

spawn qemu-system-x86_64 \
    -name FoxoOS-sata-test \
    -machine pc,accel=tcg \
    -m 2048 -smp 2 \
    -cdrom $iso \
    -device ahci,id=ahci \
    -drive file=$disk,format=raw,id=satadisk,if=none \
    -device ide-hd,drive=satadisk,bus=ahci.0 \
    -boot d \
    -nic user,model=e1000 \
    -display none -monitor none -serial stdio \
    -no-reboot

expect {
    -re "foxoos login:" {}
    timeout {
        puts stderr "TIMEOUT waiting for login"
        exit 1
    }
}

send "foxos\r"
expect "Password:"
send "live\r"
expect {[$#] $}

send "echo PWQ_TEST_START\r"
expect "PWQ_TEST_START"
expect {[$#] $}

send "ls -la /var/cache/cracklib\r"
expect {[$#] $}

send "echo password | /usr/sbin/cracklib-check\r"
expect {[$#] $}

send "echo 12345678 | /usr/sbin/cracklib-check\r"
expect {[$#] $}

send "echo 'V3ryStr0ng!P@ssw0rd#2026' | /usr/sbin/cracklib-check\r"
expect {[$#] $}

# Run Calamares offscreen with debug
send "sudo env KPMCORE_DEBUG=1 /usr/bin/calamares -d -platform offscreen > /tmp/calamares.log 2>&1 &\r"
expect {[$#] $}

send "sleep 60\r"
expect {[$#] $}

send "echo LOG_DUMP_START; cat /tmp/calamares.log; echo LOG_DUMP_END\r"
expect "LOG_DUMP_END"
expect {[$#] $}

send "echo PWQ_TEST_END\r"
expect "PWQ_TEST_END"
expect {[$#] $}

send "sudo poweroff -f || sudo halt -f -p\r"
set timeout 30
expect {
    eof {}
    timeout { puts "Poweroff complete" }
}
